DB_HOST=localhost
DB_PORT=3306
DB_NAME=bluemoon_db
DB_USER=root
DB_PASS=your_mysql_password_here

# JWT — bắt buộc đổi khi triển khai thật; khóa phải dài tối thiểu 32 byte
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=28800000

# Nguồn frontend được phép gọi API (nhiều origin cách nhau bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:5173
